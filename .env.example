# ─── App ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=iMaket
# Platform commission taken from each sale (percent)
PLATFORM_FEE_PERCENT=5
# Default display currency (ZMW, NGN, KES, GHS, UGX, ZAR, USD …)
NEXT_PUBLIC_DEFAULT_CURRENCY=ZMW

# ─── Supabase ────────────────────────────────────────────────────────
# Leave both blank to run in DEMO MODE (sample data, no auth).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Payments (fill in the providers you enable) ─────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox            # sandbox | live
PAYPAL_WEBHOOK_ID=

FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=     # "secret hash" set in the Flutterwave dashboard

DUSUPAY_PUBLIC_KEY=
DUSUPAY_SECRET_KEY=
DUSUPAY_WEBHOOK_SECRET=
DUSUPAY_ENV=sandbox           # sandbox | live

# Which aggregator powers the "Mobile money" checkout option: dusupay | flutterwave
MOBILE_MONEY_GATEWAY=

# ─── Email (Resend) ──────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="iMaket <hello@yourdomain.com>"

# ─── Cron (Vercel sends this as a Bearer token) ──────────────────────
CRON_SECRET=
NEXT_PUBLIC_MAX_UPLOAD_MB=50
